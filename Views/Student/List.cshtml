@model IEnumerable<StudentRegistrationMVC.Models.Student>

@{
    ViewData["Title"] = "Registered Students";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-primary">
                <i class="bi bi-people-fill me-2"></i>Registered Students
            </h2>
            <p class="text-muted mb-0">Records of all students registered in the system (Stored in Database).</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Register New Student
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 text-center py-5">
            <div class="card-body">
                <div class="display-1 text-muted mb-3">
                    <i class="bi bi-folder-x"></i>
                </div>
                <h4 class="fw-bold text-secondary">No Students Registered Yet</h4>
                <p class="text-muted mb-4">Be the first to register a new student using our registration form.</p>
                <a asp-action="Create" class="btn btn-success px-4 py-2">
                    <i class="bi bi-plus-circle me-1"></i> Go to Registration Form
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">ID</th>
                            <th>Student Name</th>
                            <th>Enrollment No</th>
                            <th>Course</th>
                            <th>Department</th>
                            <th>Semester</th>
                            <th>Mobile</th>
                            <th>Hosteller</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">#@student.StudentId</td>
                                <td class="fw-semibold">@student.FullName</td>
                                <td><span class="badge bg-light text-dark border">@student.EnrollmentNumber</span></td>
                                <td><span class="badge bg-primary">@student.Course</span></td>
                                <td>@student.Department</td>
                                <td>@student.Semester</td>
                                <td>+91 @student.MobileNumber</td>
                                <td>
                                    @if (student.IsHosteller)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@student.StudentId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i> View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-light py-3 text-muted small">
                Showing total <strong>@Model.Count()</strong> registered student(s).
            </div>
        </div>
    }
</div>
