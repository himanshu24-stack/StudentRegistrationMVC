@model StudentRegistrationMVC.Models.Student

@{
    ViewData["Title"] = "Student Details - " + Model.FullName;
}

<div class="container py-4">
    <!-- Top Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-primary">
                <i class="bi bi-person-badge me-2"></i>Student Profile Details
            </h2>
            <p class="text-muted mb-0">Complete registration and academic dossier for Student ID #@Model.StudentId</p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-secondary">
                <i class="bi bi-printer me-1"></i> Print / Save PDF
            </button>
            <a asp-action="List" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i> New Registration
            </a>
        </div>
    </div>

    <!-- Student Quick Overview Card -->
    <div class="card shadow-sm border-0 mb-4 rounded-3 bg-light">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-auto">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-2" style="width: 75px; height: 75px;">
                        @(Model.FirstName.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "S")
                    </div>
                </div>
                <div class="col">
                    <h3 class="fw-bold mb-1">@Model.FullName</h3>
                    <p class="text-muted mb-2">
                        <span class="badge bg-primary me-2">@Model.Course</span>
                        <span class="badge bg-info text-dark me-2">@Model.Department</span>
                        <span class="badge bg-secondary me-2">@Model.Semester</span>
                        <span class="badge bg-dark">ID: #@Model.StudentId</span>
                    </p>
                    <small class="text-muted">
                        <i class="bi bi-calendar-check me-1"></i> Registered on: @Model.RegistrationDate.ToString("dd MMMM yyyy, hh:mm tt")
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- 1. PERSONAL DETAILS -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100 rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-semibold text-primary mb-0">
                        <i class="bi bi-person me-2"></i>1. Personal Details
                    </h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <tbody>
                            <tr>
                                <th class="w-40 ps-4 text-muted">Student ID</th>
                                <td class="fw-bold text-primary">#@Model.StudentId</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">First Name</th>
                                <td>@Model.FirstName</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Middle Name</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.MiddleName) ? "—" : Model.MiddleName)</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Last Name</th>
                                <td>@Model.LastName</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Date of Birth</th>
                                <td>@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd-MMM-yyyy") : "—")</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Gender</th>
                                <td>
                                    <span class="badge bg-light text-dark border">@Model.Gender</span>
                                </td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Blood Group</th>
                                <td>
                                    <span class="badge bg-danger">@Model.BloodGroup</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 2. CONTACT DETAILS -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100 rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-semibold text-primary mb-0">
                        <i class="bi bi-telephone me-2"></i>2. Contact Details
                    </h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <tbody>
                            <tr>
                                <th class="w-40 ps-4 text-muted">Email Address</th>
                                <td>
                                    <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                                </td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Mobile Number</th>
                                <td>
                                    <a href="tel:+91@Model.MobileNumber" class="text-decoration-none">+91 @Model.MobileNumber</a>
                                </td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Emergency Contact Name</th>
                                <td class="fw-medium">@Model.EmergencyContactName</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Emergency Contact Phone</th>
                                <td>
                                    <a href="tel:+91@Model.EmergencyContactNumber" class="text-decoration-none text-danger fw-medium">
                                        +91 @Model.EmergencyContactNumber
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 3. ADDRESS DETAILS -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100 rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-semibold text-primary mb-0">
                        <i class="bi bi-geo-alt me-2"></i>3. Address Details
                    </h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <tbody>
                            <tr>
                                <th class="w-40 ps-4 text-muted">Residential Address</th>
                                <td>@Model.Address</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">City</th>
                                <td>@Model.City</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">State</th>
                                <td>@Model.State</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Pincode</th>
                                <td><span class="badge bg-secondary">@Model.Pincode</span></td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Country</th>
                                <td>@Model.Country</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 4. ACADEMIC DETAILS -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100 rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-semibold text-primary mb-0">
                        <i class="bi bi-mortarboard me-2"></i>4. Academic Details
                    </h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <tbody>
                            <tr>
                                <th class="w-40 ps-4 text-muted">Course</th>
                                <td class="fw-bold text-primary">@Model.Course</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Department</th>
                                <td>@Model.Department</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Semester</th>
                                <td>@Model.Semester</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Enrollment Number</th>
                                <td class="fw-bold">@Model.EnrollmentNumber</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Previous School/College</th>
                                <td>@Model.PreviousSchoolCollege</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Previous Percentage</th>
                                <td>
                                    <span class="badge @(Model.Percentage >= 75 ? "bg-success" : Model.Percentage >= 60 ? "bg-primary" : "bg-warning") fs-6">
                                        @(Model.Percentage.HasValue ? Model.Percentage.Value.ToString("0.00") + "%" : "—")
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 5. PARENT / GUARDIAN DETAILS -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100 rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-semibold text-primary mb-0">
                        <i class="bi bi-people me-2"></i>5. Parent / Guardian Details
                    </h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <tbody>
                            <tr>
                                <th class="w-40 ps-4 text-muted">Father's Name</th>
                                <td class="fw-medium">@Model.FatherName</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Mother's Name</th>
                                <td class="fw-medium">@Model.MotherName</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Guardian's Name</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.GuardianName) ? "—" : Model.GuardianName)</td>
                            </tr>
                            <tr>
                                <th class="ps-4 text-muted">Guardian's Mobile</th>
                                <td>
                                    @(string.IsNullOrWhiteSpace(Model.GuardianMobileNumber)
                                        ? "—"
                                        : $"+91 {Model.GuardianMobileNumber}")
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 6. ADDITIONAL DETAILS -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100 rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-semibold text-primary mb-0">
                        <i class="bi bi-info-circle me-2"></i>6. Additional Details
                    </h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <tbody>
                            <tr>
                                <th class="w-40 ps-4 text-muted">Is Hosteller?</th>
                                <td>
                                    @if (Model.IsHosteller)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i> No (Day Scholar)</span>
                                    }
                                </td>
                            </tr>
                            @if (Model.IsHosteller)
                            {
                                <tr>
                                    <th class="ps-4 text-muted">Hostel Name</th>
                                    <td class="fw-bold text-dark">@Model.HostelName</td>
                                </tr>
                            }
                            <tr>
                                <th class="ps-4 text-muted">Hobbies / Interests</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.Hobbies) ? "None specified" : Model.Hobbies)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
